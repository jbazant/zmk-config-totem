#include <locale/keys_cs_programmers.h>
#include <locale/keys_de.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base    0
#define Nav     1
#define Sym     2
#define Fun     3
#define Czech   4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        lock: lock {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&kp LCTRL>
                , <&kp LGUI>
                , <&kp Q>
                , <&kp LGUI>
                , <&kp LCTRL>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                &kp Q       &kp W       &kp E          &kp R         &kp T        &kp Y    &kp U         &kp I        &kp O       &kp P
                &hm LCTRL A  &hm LALT S  &hm LGUI D    &hm LSHIFT F  &kp G        &kp H    &hm RSHFT J   &hm RGUI K  &hm RALT L  &hm RCTRL SEMICOLON
&lt Fun ESCAPE  &kp Z       &kp X       &kp C          &kp V         &kp B        &kp N    &kp M         &kp COMMA    &kp DOT     &kp SLASH           &lt Czech APOSTROPHE
                                        &mt LGUI DEL  &lt Nav TAB   &kp SPACE    &kp RET  &lt Sym BSPC  &lt 4 MINUS
            >;
        };

        Nav {
            display-name = "Navigation";
            bindings = <
              &kp TILDE       &kp HOME   &kp UP_ARROW  &kp END               &kp PG_UP                &kp KP_DIVIDE    &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
              &kp LEFT_SHIFT  &kp LEFT   &kp DOWN      &kp RIGHT             &kp PAGE_DOWN            &kp KP_MULTIPLY  &hm RSHFT NUMBER_4   &hm RGUI NUMBER_5  &hm RALT NUMBER_6  &hm RCTRL PLUS
&kp LEFT_ALT  &kp LEFT_WIN    &kp COMMA  &kp UNDER     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp N0           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &trans
                                         &trans        &trans                &trans                   &trans           &trans        &kp DOT
            >;
        };

        Sym {
            display-name = "Symbols";
            bindings = <
        &kp EXCL  &kp AT  &kp HASH        &kp DOLLAR       &kp PERCENT    &kp CARET  &kp AMPERSAND      &kp KP_ASTERISK       &kp SQT          &kp DQT
        &trans    &trans  &hm LGUI LBRC  &hm LSHIFT LBKT   &kp LPAR       &kp AT     &hm RSHFT DE_EURO  &hm RGUI DE_SECTION   &hm RALT CS_DEG  &hm RCTRL BACKSLASH
&trans  &trans    &trans  &kp RBRC        &kp RBKT         &kp RPAR       &kp UNDER  &kp EQUAL          &trans                &trans           &trans    &trans
                          &trans          &trans           &trans         &trans     &trans             &trans
            >;
        };

        Fun {
            display-name = "FN";
            bindings = <
        &trans  &trans  &kp C_MUTE      &kp C_VOLUME_DOWN       &kp C_VOLUME_UP    &kp F1   &kp F2   &kp F3  &kp F4  &kp F5
        &trans  &trans  &hm LGUI D      &hm LSHIFT C_BRI_DEC    &kp C_BRI_INC      &kp F6   &kp F7   &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE        &kp C_NEXT         &kp F12  &kp F12  &trans  &trans  &lock  &trans
                        &trans          &trans                  &trans             &trans   &trans   &trans
            >;
        };

        Czech {
            display-name = "Czech";
            bindings = <
        &kp CS_E_CARON  &kp CS_S_CARON  &kp CS_C_CARON  &kp CS_R_CARON  &kp CS_Z_CARON    &kp CS_Y_ACUTE  &kp CS_A_ACUTE  &kp CS_I_ACUTE  &kp CS_E_ACUTE  &trans
        &trans          &trans          &trans          &trans          &trans            &kp CS_U_ACUTE  &kp CS_U_RING   &trans          &trans          &trans
&trans  &trans          &trans          &trans          &trans          &trans            &trans          &trans          &trans          &trans          &trans  &trans
                                        &trans          &trans          &trans            &trans          &trans          &trans
            >;
        };
    };
};
